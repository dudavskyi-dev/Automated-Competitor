# Copy this file to .env and fill in real values. .env is gitignored.
# No API key is needed - the LLM runs locally via Ollama:
#   winget install --id Ollama.Ollama -e
#   ollama pull qwen2.5:3b

# Optional: any model you've pulled with `ollama pull` (defaults to qwen2.5:3b)
OLLAMA_MODEL=qwen2.5:3b

# Optional: where the local Ollama server listens (defaults to http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Leave OPENAI_API_KEY empty to use the local Ollama setup above (default).
# Fill it in to use OpenAI instead - no Ollama install needed.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional: URL the manual smoke test (scripts/smoke_test.py) will run against
SMOKE_TEST_URL=https://www.anthropic.com
