# Copy this file to .env and fill in real values. .env is gitignored.

# Required: get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: any model slug from https://openrouter.ai/models (defaults to a free model)
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Optional: URL the manual smoke test (scripts/smoke_test.py) will run against
SMOKE_TEST_URL=https://www.anthropic.com
